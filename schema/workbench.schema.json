{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json",
  "title": "DSH Workbench directory entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "name",
    "category",
    "description",
    "screenshots"
  ],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "category": {
      "type": "string",
      "enum": [
        "development",
        "productivity",
        "content",
        "data",
        "research",
        "operations",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "release": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/(download/[^/]+|latest/download)/[^/?#]+\\.tgz$"
    }
  }
}
